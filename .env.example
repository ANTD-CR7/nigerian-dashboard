# Copy this file to .env locally (or set these in the Render dashboard for
# production) and fill in real values. Never commit the real .env file.
# SUPABASE_URL and SUPABASE_KEY are required -- main.py fails loudly on
# startup if either is unset. There is no hardcoded fallback: the public
# anon key previously hardcoded in this repo was read-write (audit finding
# #1/#107) and has since been rotated, so an old cached value will not work.

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Required only to actually write data (see ALLOW_DATA_WRITES below): the
# service-role key, which bypasses RLS/GRANTs by design. Never the same
# value as SUPABASE_KEY above, and never committed. Without this set, write
# endpoints stay demo-safe (validate/normalize only) even if
# ALLOW_DATA_WRITES=true.
SUPABASE_SERVICE_KEY=

# Set to "true" to allow POST /api/v1/observations and /api/v1/ingest/csv to
# actually write to the database (also requires SUPABASE_SERVICE_KEY above).
# Defaults to "false" (demo-safe: validates and normalizes rows but never
# commits them).
ALLOW_DATA_WRITES=false

# Optional: enable the AI "ask the data" assistant (POST /api/v1/ask).
# Without ANTHROPIC_API_KEY the endpoint returns 503 and the rest of the API
# is unaffected. NPE_AI_MODEL is optional (defaults to claude-sonnet-5).
ANTHROPIC_API_KEY=
NPE_AI_MODEL=claude-sonnet-5

# Optional: API-key auth + simple rate limiting. Leave NPE_API_KEYS blank to
# keep the API fully open (current behaviour). Set a comma-separated list of
# accepted keys to require an X-API-Key header on data endpoints.
NPE_API_KEYS=
NPE_RATE_LIMIT_PER_MIN=120
